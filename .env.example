# Copia questo file in .env e compila i valori. NON committare mai .env

# --- LLM (senza chiave il bot lavora in modalità "euristica", utile per test) ---
ANTHROPIC_API_KEY=
NEWSBOT_MODEL=claude-sonnet-5

# --- Embeddings: auto | st (sentence-transformers) | tfidf (leggero, meno preciso) ---
NEWSBOT_EMBEDDINGS=auto
NEWSBOT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Sentiment: none | hf (richiede extra "sentiment") ---
NEWSBOT_SENTIMENT=none

# --- Revisione su Telegram (BotFather -> token; chat id tuo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Scraper social di terzi (opzionale) ---
APIFY_TOKEN=

# --- Percorsi (opzionali) ---
# NEWSBOT_DB=data/newsbot.db
# NEWSBOT_OUTPUT=output
